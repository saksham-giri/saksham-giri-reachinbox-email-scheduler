# --- Server ---
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# --- Infra (matches docker-compose.yml) ---
DATABASE_URL=postgresql://scheduler:scheduler@127.0.0.1:5433/scheduler
REDIS_URL=redis://127.0.0.1:6380
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=emails

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# --- Slack OAuth (https://api.slack.com/apps) - scope: incoming-webhook ---
# Slack requires an HTTPS redirect URL; use ngrok/cloudflared pointing at port 4000.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://your-tunnel.ngrok-free.app/api/slack/callback

# --- Worker / throughput ---
WORKER_CONCURRENCY=5
# Minimum gap between two consecutive sends (BullMQ limiter, enforced across all workers)
MIN_SEND_INTERVAL_MS=2000
JOB_ATTEMPTS=3

# --- Rate limiting (Redis counters, fixed windows) ---
MAX_EMAILS_PER_HOUR_PER_SENDER=50
# Optional global cap across all senders; 0 disables it
MAX_EMAILS_PER_HOUR=0
# Window length; keep 3600000 (1h) in production. Lower it (e.g. 60000) to demo rollover quickly.
RATE_LIMIT_WINDOW_MS=3600000

# --- Ethereal senders ---
# Number of Ethereal accounts auto-created on first boot (persisted in the DB)
ETHEREAL_SENDER_COUNT=3
# Or provide your own accounts instead (JSON): [{"name":"Alice","user":"x@ethereal.email","pass":"..."}]
# ETHEREAL_SENDERS=

# --- Bull Board (optional basic auth for /admin/queues) ---
# BULL_BOARD_USER=admin
# BULL_BOARD_PASS=admin
