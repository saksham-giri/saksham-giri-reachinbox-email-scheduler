# Copy to .env.production on the server and fill in. Never commit .env.production.
# Infrastructure URLs (database, Redis, Elasticsearch) are set in docker-compose.prod.yml.

# --- Your public domain (DNS A record must point at this server) ---
DOMAIN=scheduler.example.com

# --- Secrets: generate each with `openssl rand -hex 32` ---
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# --- Google OAuth: add https://<DOMAIN>/api/auth/google/callback as a redirect URI ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Slack OAuth: add https://<DOMAIN>/api/slack/callback as a redirect URL ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://scheduler.example.com/api/slack/callback

# --- Bull Board is public in production: always set these ---
BULL_BOARD_USER=admin
BULL_BOARD_PASS=change-me

# --- Throughput and limits ---
WORKER_CONCURRENCY=5
MIN_SEND_INTERVAL_MS=2000
JOB_ATTEMPTS=3
MAX_EMAILS_PER_HOUR_PER_SENDER=50
MAX_EMAILS_PER_HOUR=0
RATE_LIMIT_WINDOW_MS=3600000

# --- Ethereal senders (created automatically on first boot) ---
ETHEREAL_SENDER_COUNT=3
ELASTICSEARCH_INDEX=emails
